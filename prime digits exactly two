import java.util.*;

public class Main {
    public static void main(String[] args) {

        int count = 0;

        for (int i = 250; i <= 750; i++) {

            int n = i;
            int primeCount = 0;

            while (n > 0) {
                int digit = n % 10;

                if (digit == 2 || digit == 3 || digit == 5 || digit == 7) {
                    primeCount++;
                }

                n = n / 10;
            }

            if (primeCount == 2) {
                count++;
            }
        }

        System.out.println(count);
    }
}
